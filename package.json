{
  "name": "bumihijau",
  "version": "1.0.0",
  "private": true,
  "description": "Toko online BumiHijau: produk ramah lingkungan untuk mengurangi global warming (SDG 12 dan 13)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
