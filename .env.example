# Salin file ini menjadi .env lalu isi dengan kunci dari dashboard Midtrans
# (Midtrans > Environment: Sandbox > Pengaturan > Access Keys)

MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Password untuk membuka halaman /admin
ADMIN_PASSWORD=admin123

# Port server Express
PORT=3001
